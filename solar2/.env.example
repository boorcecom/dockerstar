# Compte MariaDB en lecture seule (SELECT sur la base solar uniquement)
SOLAR_DB_USER=solarview
SOLAR_DB_PASSWORD=CHANGE_ME

# Optionnel (valeurs par défaut entre parenthèses)
# SOLAR_DB_HOST=mariadb
# SOLAR_DB_NAME=solar
# SOLAR_TZ=Europe/Paris        # fuseau dans lequel le collecteur écrit les datetime
# SOLAR_INVERTER_ID=0          # 0 = détection automatique
# SOLAR_LAT= / SOLAR_LON=      # sinon lus dans la table coordonee
# SOLAR_RATE_RPS=5  SOLAR_RATE_BURST=20
# SOLAR_TRUST_PROXY=true       # derrière le reverse proxy Apache
# SOLAR_CORS_ORIGIN=           # utile seulement pour une future appli hébergée ailleurs
